{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host=0.0.0.0 --port=5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host=0.0.0.0 --port=4173",
    "check": "tsc --noEmit && npm test && npm run build",
    "test": "node tools/run-tests.mjs",
    "perf": "node tools/run-tests.mjs perf",
    "clean:browser": "node tools/browser/clean-shots.mjs",
    "test:browser": "node tests/browser/serve-wrapper.mjs && node tests/browser/boot.mjs",
    "check:browser": "npm run clean:browser && node tools/browser/smoke.mjs && node tools/browser/world.mjs && node tools/browser/robustness.mjs",
    "check:all": "npm run check && npm run check:browser"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "playwright": "^1.63.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
